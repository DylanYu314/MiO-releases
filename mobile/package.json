{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@mio/shared": "file:../shared",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.12",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "3.1.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.3",
    "youtubei.js": "^17.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "expo export --platform android",
    "ota:check": "node --experimental-strip-types scripts/ota-check.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "testTimeout": 20000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^youtubei\\.js/react-native$": "<rootDir>/__mocks__/youtubeiStub.js",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    },
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ]
  },
  "private": true,
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    },
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
