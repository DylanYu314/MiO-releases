# Copy to .env and adjust as needed. Both have sensible defaults for local dev
# (see app/config.py) — this file only matters if you want to override them.
DATABASE_URL=sqlite:///./data/mio.db
LIBRARY_PATH=./data/library

# Celery's broker and the channel job progress is published on (ADR-006).
# docker compose sets this to the compose service; override for a local Redis.
# Setting it empty runs tasks inline instead of queueing them.
REDIS_URL=redis://localhost:6379/0

# Logging: json (machine-queryable, the default) or text (easier to read live).
LOG_LEVEL=INFO
LOG_FORMAT=json

# Download pacing for batch imports (see app/config.py). The pause between
# downloads is adaptive: it starts at DOWNLOAD_PACING_SECONDS, shrinks after a
# success and grows after a transient failure, within the min/max band. Set
# DOWNLOAD_PACING_SECONDS=0 to disable pacing entirely. Defaults shown.
# DOWNLOAD_PACING_SECONDS=3.0
# DOWNLOAD_PACING_MIN_SECONDS=1.0
# DOWNLOAD_PACING_MAX_SECONDS=30.0
# DOWNLOAD_PACING_SHRINK=0.8
# DOWNLOAD_PACING_GROW=2.0

# Transient (throttling/timeout) download failures are retried with exponential
# backoff — DOWNLOAD_RETRY_BACKOFF_SECONDS, then double each attempt — up to
# DOWNLOAD_MAX_RETRIES times. Applies to both single jobs and batch imports.
# DOWNLOAD_MAX_RETRIES=3
# DOWNLOAD_RETRY_BACKOFF_SECONDS=20

# Spotify import (optional — leave unset and the feature is simply off).
# Client ID comes from https://developer.spotify.com/dashboard; the PKCE flow
# needs no client secret. The redirect URI must exactly match one registered
# in the dashboard (loopback IP — Spotify rejects "localhost"). See ADR-005.
# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
# FRONTEND_BASE_URL=http://localhost:5173
# Where the callback sends the browser when the *Android app* started the login
# (#203). A deep link back into the app; only change it if the app's scheme in
# mobile/app.json changes. Note this is not registered with Spotify — their
# redirect URI is still SPOTIFY_REDIRECT_URI above, and this is the hop after it.
# SPOTIFY_APP_REDIRECT_URI=mio://add/import

# Private YouTube playlist import (#106, optional — unset and the feature is off,
# and the /google endpoints answer 503). Full setup: docs/google-oauth-setup.md.
#
# Unlike Spotify this needs a real CLIENT SECRET — Google issues one for "Web
# application" clients and requires it at the token exchange, so it belongs here
# and never in a client bundle. The redirect URI must match a registered one
# exactly, including scheme, case and trailing slash; http://localhost is allowed
# (Google exempts it from the HTTPS rule), which is the opposite of Spotify.
#
# While the consent screen is in "Testing", refresh tokens expire after 7 days
# and the account has to be reconnected. That is Google's rule, not a bug.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# Access keys (ADR-009). The import gate normally turns on once you create the
# first key (scripts/access_keys.py). Set this true on a hosted deployment to
# keep imports locked even before any key exists, so it's never accidentally open.
# REQUIRE_ACCESS_KEY=true

# How long client diagnostics are kept (#322). `client_errors` holds crashes
# and the Android app's daily log — an ungated endpoint writes to it and every
# device adds to it daily, so it is the one table here that grows on its own.
# The sweep runs at startup and after each upload. 0 keeps everything.
# CLIENT_ERROR_RETENTION_DAYS=30
