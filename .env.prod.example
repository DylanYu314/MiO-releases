# Configuration for the production stack. Copy to `.env.prod` and fill in.
#
#   cp .env.prod.example .env.prod
#   docker network create edge
#   docker compose --env-file .env.prod -f docker-compose.proxy.yml up -d
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Two projects: the shared edge proxy owns 80/443 and the certificates, MiO
# publishes nothing, and both are reached over a shared external network. That
# split is what lets one host serve more than this app.
#
# `.env.prod` is gitignored and excluded from every build context — nothing here
# should ever reach an image or the repository.

# The domain pointing at this server. Caddy issues a certificate for exactly
# this name, so it must already resolve to the host's public IP.
#
# Set to `localhost` to run the whole stack locally: Caddy then signs with its
# own internal CA and never contacts Let's Encrypt.
MIO_DOMAIN=mio.example.com

# INFO in normal operation; DEBUG when chasing something.
MIO_LOG_LEVEL=INFO

# Spotify playlist import (see ADR-005). Leave empty to run without it — the
# /spotify endpoints answer 503 and nothing else is affected.
#
# The redirect URI registered in the Spotify dashboard must be exactly
# https://<MIO_DOMAIN>/api/spotify/callback — including the /api prefix, which
# is Caddy's and is part of the public URL.
SPOTIFY_CLIENT_ID=

# Private YouTube playlist import (see ADR-014). Leave empty to run without
# it — the /google endpoints answer 503 and nothing else is affected.
#
# Setting this up in the Google console is four separate pages, and skipping one
# is the usual failure. The redirect URI registered there must be exactly
# https://<MIO_DOMAIN>/api/google/callback.
#
# Unlike Spotify, this flow is a confidential client: the secret is required,
# and it is a real credential — it belongs in this file and nowhere else.
#
# ⚠️ Check it took effect with `curl https://<MIO_DOMAIN>/api/google/status`,
# which reports `configured`. Settings are read once at import and cached, so
# editing this file needs the backend restarted, not just written.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube cookies — ⚠️ interim, and only for a server-side import.
#
# The Android app never uses this: it fetches its own audio directly, which is
# what removed the need. This matters only if you self-host and use the
# "other sites" route, which hands a link to yt-dlp on your own machine.
#
# YouTube refuses this server's address: measured 1 import in 14, while the same
# 14 URLs succeed from a home connection. A signed-in account's cookies are the
# only remaining way to make a datacenter IP look like a person.
#
# Leave empty and nothing is mounted and nothing changes — the stack runs
# exactly as before, at the measured 1-in-14.
#
# If you set it, use a **throwaway Google account**, never a real one: the
# account can be flagged or banned for this, and the file is a credential
# sitting on a server. ⚠️ Export the cookies from a browser session you then
# close and never reuse — continuing to browse with it invalidates them.
#
# Path on the host, absolute:
#   MIO_COOKIES_FILE=/srv/mio/secrets/cookies.txt
MIO_COOKIES_FILE=
