{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
    ⚠️ The privacy-policy guard (#741) reads files off disk, so it needs Node's
    types — and `src` is browser-typed on purpose, which is why
    `theme/tokens.test.ts` goes out of its way to use `?raw` instead. Rather
    than widen `types` here and let app code reach for `process`, that one file
    is typed by `tsconfig.node.json`. It still *runs* from `src`, which is where
    vitest looks for it.
  */
  "exclude": ["src/privacyPolicy.test.ts"]
}
